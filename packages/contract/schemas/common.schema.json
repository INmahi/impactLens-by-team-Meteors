{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trend-detective.local/contract/common.schema.json",
  "title": "Shared definitions for the Trend Detective data contract",
  "$defs": {
    "id": {
      "description": "Variable, region or layer id: lowercase snake_case.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
    },
    "monthlyDate": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
    "annualDate": { "type": "string", "pattern": "^[0-9]{4}$" },
    "date": {
      "anyOf": [{ "$ref": "#/$defs/monthlyDate" }, { "$ref": "#/$defs/annualDate" }]
    },
    "period": {
      "description": "Inclusive [start, end], same format as the series dates.",
      "type": "array",
      "prefixItems": [{ "$ref": "#/$defs/date" }, { "$ref": "#/$defs/date" }],
      "minItems": 2,
      "maxItems": 2
    },
    "frequency": {
      "description": "Series are monthly or annual. Finer sources (for example 7-day sea level) are averaged to monthly by the pipeline.",
      "enum": ["monthly", "annual"]
    },
    "kind": { "enum": ["level", "cumulative", "rate"] },
    "numOrNullArray": {
      "type": "array",
      "items": { "type": ["number", "null"] }
    },
    "bbox": {
      "description": "[west, south, east, north] in degrees.",
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 },
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "source": {
      "type": "object",
      "required": ["name", "url", "citation"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "citation": { "type": "string", "minLength": 1 },
        "doi": { "type": "string" },
        "version": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
